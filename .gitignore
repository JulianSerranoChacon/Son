# Archivos y carpetas generados automáticamente
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
# Archivos de registro
*.log
# Archivos de respaldo de Blender
*.blend1
*.blend1.meta
# Capturas de memoria y grabaciones
[Mm]emoryCaptures/
[Rr]ecordings/
# Configuración específica de IDEs
vs/
gradle/
*.csproj
*.unityproj
*.sln
*.userprefs
# Archivos generados por Unity en caso de fallos
sysinfo.txt
mono_crash.*
# Archivos de compilación y paquetes
*.apk
*.aab
*.unitypackage
# Ignorar datos generados por Addressables y Visual Scripting
[Aa]ssets/AddressableAssetsData/*/*.bin*
[Aa]ssets/Unity.VisualScripting.Generated/
# Escenas generadas automáticamente por pruebas en modo Play
[Aa]ssets/InitTestScene*.unity*
*.meta
*.vsidx
*.asset
/Practca3/My project/.vs
*.bin
*.slnx
# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log